"""
A utility for controlling ACE loggers, such as splitting logs, or stopping, ... etc.
"""

import argparse
import datetime
import logging
import sys

import rclpy
import rclpy.node
import rclpy.qos
from ace_loggers import logger_pybind as ace_logger

import ace_interfaces.msg

log = logging.getLogger(__name__)


def _publish_log_prefix(log_prefix):
    qos_persistent = rclpy.qos.QoSProfile(depth=1)
    qos_persistent.reliability = rclpy.qos.QoSReliabilityPolicy.RELIABLE
    qos_persistent.durability = rclpy.qos.QoSDurabilityPolicy.TRANSIENT_LOCAL
    dummy_node = rclpy.node.Node("ace_log")
    logger_control_pub = dummy_node.create_publisher(
        ace_interfaces.msg.LoggerControl, "/logger/control", qos_persistent
    )

    loggercontrol_msg = ace_interfaces.msg.LoggerControl()
    loggercontrol_msg.log_prefix[: len(log_prefix)] = list(log_prefix.encode("utf-8"))

    logger_control_pub.publish(loggercontrol_msg)
    rclpy.spin_once(dummy_node, timeout_sec=3)  # Keep alive for a while
    subscription_count = logger_control_pub.get_subscription_count()

    log.info('Sent LoggerControl(log_prefix="%s") to %d nodes', log_prefix, subscription_count)
    return True


def _command_start(args):
    if _publish_log_prefix(args.log_prefix):
        log.info("ACE logging started successfully")
        return 0
    log.error("Starting ACE logs failed!")
    return -1


def _command_split(args):
    if args.as_dir:
        log_prefix = f"{args.log_prefix}/log_{datetime.datetime.now().strftime('%Y-%m-%dT%H-%M-%S')}"
    else:
        log_prefix = args.log_prefix
    if _publish_log_prefix(log_prefix):
        log.info('ACE logs split successfully, with new ones having log_prefix="%s"', log_prefix)
        return 0
    log.error("Splitting ACE logs failed!")
    return -1


def _command_stop(args):
    if _publish_log_prefix(""):
        log.info("ACE logging stopped successfully")
        return 0
    log.error("Stopping ACE logs failed!")
    return -1


def parse_args():
    """
    Provide script-specific arguments.

    @return: Parsed argument object
    """
    parser = argparse.ArgumentParser(description="A simple command-line tool for managing ACE logs")
    parser.add_argument("--log-level", default=logging.INFO, help="Logging level (default: %(default)s)")
    subparsers = parser.add_subparsers(dest="command", required=True)

    parser_start = subparsers.add_parser("start", help="Starts logging")
    parser_start.add_argument(
        "--log-prefix",
        type=str,
        default=f"log_{datetime.datetime.now().strftime('%Y-%m-%dT%H-%M-%S')}",
        help="The new log prefix to set (default: %(default)s)",
    )
    parser_start.set_defaults(func=_command_start)

    parser_split = subparsers.add_parser("split", help="Splits into multiple log files")
    parser_split.add_argument("log_prefix", type=str, help="The new log prefix to set")
    parser_split.add_argument(
        "--folder",
        "--dir",
        dest="as_dir",
        action="store_true",
        help="The log prefix will be handled as folder name",
    )
    parser_split.set_defaults(func=_command_split)

    parser_stop = subparsers.add_parser("stop", help="Stops logging")
    parser_stop.set_defaults(func=_command_stop)

    return parser.parse_args()


def main(argv):
    """
    Entry point to ACE-logs tools.
    @return: exit code
    """

    rclpy.init(args=argv)

    args = parse_args()

    ace_logger.initialize()
    ace_logger.set_level(str(args.log_level))
    log.setLevel(args.log_level)

    return args.func(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
