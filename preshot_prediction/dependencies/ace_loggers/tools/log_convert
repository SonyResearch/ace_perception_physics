#!/usr/bin/env python3
"""
A script for converting & merging dataset(s).

Topics from all input datasets are converted to a single ROS bag.

Confidential, Copyright 2024, Sony AI, All rights reserved.
"""
import argparse
import logging
import os
import sys
from typing import List

import coloredlogs
import rosbag_dataloaders.dataloaders
from rclpy.serialization import serialize_message
from rosbag2_py import SequentialWriter
from rosbag2_py._storage import ConverterOptions, StorageOptions, TopicMetadata

log = logging.getLogger(__name__)


def convert(dst_dir: str, src_paths: list[str], topic_filter: str = "") -> int:
    """Convert and bundle several ACE logs into a single ROS2 bag file.

    Args:
        dst_dir (str): Output directory for the ROS2 bag.
        src_paths (list[str]): List of source paths (file or directory).
        topic_filter (str): Filter string for topic names.
    """
    writer = SequentialWriter()
    storage_options = StorageOptions(uri=dst_dir, storage_id="sqlite3")
    converter_options = ConverterOptions("", "")
    writer.open(storage_options, converter_options)

    log.info("Reading dataset(s) ...")
    paths = []
    for src_path in src_paths:
        if os.path.isfile(src_path):
            paths.append(src_path)
            continue
        for dirpath, _, filenames in os.walk(src_path):
            for filename in filenames:
                if filename.endswith((".db3", ".ace")):
                    paths.append(os.path.join(dirpath, filename))
    log.info("Found %u files!", len(paths))

    topic_names = set()
    for path in paths:
        log.info('Storing "%s" in ROS2 bag...', path)
        rosbag_parser = rosbag_dataloaders.dataloaders.get_parser(path)
        for topic_name, topic_type in rosbag_parser.get_topics_with_types():
            if topic_filter and topic_filter not in topic_name:
                continue
            if topic_name not in topic_names:
                log.info('Writing header for topic "%s" ...', topic_name)
                topic_info = TopicMetadata(name=topic_name, type=topic_type, serialization_format="cdr")
                writer.create_topic(topic_info)
                topic_names.add(topic_name)
            else:
                log.warning('Header for topic "%s" has already been written.', topic_name)
            log.info('Writing data for topic "%s" ...', topic_name)
            for timestamp, msg in rosbag_parser.get_messages(topic_name):
                writer.write(topic_name, serialize_message(msg), int(0.5 + timestamp * 1e9))

    log.info("Wrote %u topics in total!", len(topic_names))
    return 0


def parse_args(argv: List[str]) -> argparse.Namespace:
    """Parse command-line arguments.

    Returns:
        argparse.Namespace: Parsed argument object.
    """
    parser = argparse.ArgumentParser(
        description="Convert generic dataset(s). Topics from all input datasets are converted to a single ROS bag."
    )
    parser.add_argument("-o", "--output_dir", required=True, help="Path to the output ROS2 bag file")
    parser.add_argument(
        "-p",
        "--path",
        dest="input_paths",
        type=str,
        nargs="+",
        required=True,
        help="Path to the data log file or folder containing it",
    )
    parser.add_argument(
        "--topic-filter",
        type=str,
        default="",
        help="String for partial matching with topic names (default: %(default)s)",
    )
    parser.add_argument("--log_level", default=logging.INFO, help="Logging level (default: %(default)s)")

    return parser.parse_args(argv)


def main(argv: List[str]) -> int:
    """Main entry-point to perform the conversion"""
    args = parse_args(argv[1:])
    coloredlogs.install(level=args.log_level)
    log.setLevel(args.log_level)

    return convert(
        args.output_dir,
        args.input_paths,
        topic_filter=args.topic_filter,
    )


if __name__ == "__main__":
    sys.exit(main(sys.argv))
