#!/usr/bin/env python3
"""
A script for replaying generic dataset(s).

Topics from all input datasets are synchronized and published at the same moment.
Synchronization is performed using their timestamp (assuming exact match).

Confidential, Copyright 2024, Sony AI, All rights reserved.
"""
import argparse
import importlib
import logging
import os
import sys

import coloredlogs
import rclpy
import rclpy.node
import rosbag_dataloaders.dataloaders
from python_helpers.keyboard_input import KBHit

log = logging.getLogger(__name__)


class GenericPublisher(rclpy.node.Node):
    """
    A ROS2 publisher for loaded dataset(s) that ensures they are in sync.

    """

    publishers = None

    def __init__(self, src_paths, frequency=100, loop=False, topic_filter=""):
        super().__init__("generic_publisher")

        topics = []
        messages = []
        self.kbhandler = KBHit()
        self.playing = True
        self.added_frames = 0

        exclude_types = [
            "ace_interfaces/msg/ImageDataInfo",  # Nonexistent
        ]

        log.info("Reading dataset(s) ...")
        paths = []
        for src_path in src_paths:
            if os.path.isfile(src_path):
                paths.append(src_path)
                continue
            for dirpath, _, filenames in os.walk(src_path):
                for filename in filenames:
                    if filename.endswith((".db3", ".ace")):
                        paths.append(os.path.join(dirpath, filename))
        log.info("Found %u files!", len(paths))

        for path in paths:
            log.info('Loading messages from "%s" ...', path)
            rosbag_parser = rosbag_dataloaders.dataloaders.get_parser(path, exclude_types=exclude_types)
            curr_topics = [
                (topic_name, topic_type)
                for topic_name, topic_type in rosbag_parser.get_topics_with_types()
                if topic_filter in topic_name
            ]

            for topic_name, topic_type in curr_topics:
                messages.append(dict(rosbag_parser.get_messages(topic_name)))
            topics += curr_topics
        assert len(topics) > 0

        self.topic_indices = range(len(topics))
        self.publishers = []
        log.info("Publishing topics:")
        for topic_name, topic_type in topics:
            log.info("- %s", topic_name)
            topic_module, topic_class = topic_type.replace("/", ".").rsplit(".", 1)
            topic_type = getattr(importlib.import_module(topic_module), topic_class)
            self.publishers.append(self.create_publisher(topic_type, topic_name, 1))
        log.info("")

        timestamps = set()
        for topic_index in self.topic_indices:
            timestamps.update(messages[topic_index].keys())
        timestamps = sorted(timestamps)

        self.synced_messages = [
            [messages[topic_index].get(timestamp) for topic_index in self.topic_indices] for timestamp in timestamps
        ]

        log.info(
            "Publishing messages with timestamps %.3f sec through %.3f sec ...",
            timestamps[0],
            timestamps[-1],
        )
        self.loop = loop
        self.msg_index = 0
        self.frequency = frequency
        self.timer = self.create_timer(1.0 / frequency, self.timer_callback)

    def _handle_input(self):
        self.added_frames = 0
        if self.kbhandler.kbhit():
            key = self.kbhandler.getch()
            if key == " ":
                self.playing = not self.playing
                if not self.playing:
                    self.timer.timer_period_ns = 1e9 / 30
                else:
                    self.timer.timer_period_ns = 1e9 / self.frequency
                print("Playing" if self.playing else "Paused")
            if key == "w":
                self.frequency += max(1, self.frequency // 20)
                print(f"Speed up frequency: {self.frequency}")
                self.timer.timer_period_ns = 1e9 / self.frequency
            if key == "s":
                self.frequency = max(1, self.frequency - max(1, self.frequency // 20))
                print(f"Speed down frequency: {self.frequency}")
                self.timer.timer_period_ns = 1e9 / self.frequency
            if key == "d":
                self.added_frames = 1
            if key == "a":
                self.added_frames = -1
        if self.added_frames != 0:
            self.msg_index -= 1

    def timer_callback(self):
        """
        A call back for publishing the messages belonging to the next timestamp.
        """

        self._handle_input()

        if not self.playing and self.added_frames == 0:
            return
        self.msg_index = max(0, self.msg_index + self.added_frames)
        if len(self.synced_messages) <= self.msg_index:
            if self.loop:
                log.info("Relooping from the beginning ...")
                self.msg_index = 0
            else:
                self.timer.destroy()
                log.info("Finished replaying the dataset!")
                sys.exit(0)

        messages = self.synced_messages[self.msg_index]
        for topic_index in self.topic_indices:
            msg = messages[topic_index]
            if msg is None:
                continue
            self.publishers[topic_index].publish(msg)
        log.debug("#%u", self.msg_index)
        self.msg_index += 1


def parse_args():
    """
    Provide script-specific arguments.

    @return: Parsed argument object
    """

    parser = argparse.ArgumentParser(
        description="Replay generic dataset(s). "
        "Topics from all input datasets are synchronized and published at the same moment."
    )
    parser.add_argument(
        "-p",
        "--path",
        dest="paths",
        type=str,
        nargs="+",
        required=True,
        help="Path to the dataset",
    )
    parser.add_argument(
        "--frequency",
        type=float,
        default=100,
        help="Frequency rate to reply (default: %(default)s)",
    )
    parser.add_argument(
        "--loop",
        action="store_true",
        default=False,
        help="Indefinitely loop dataset",
    )
    parser.add_argument(
        "--topic-filter",
        type=str,
        default="",
        help="A string for partial matching with topic names (default: %(default)s)",
    )
    parser.add_argument("--log_level", default=logging.INFO, help="Logging level (default: %(default)s)")

    return parser.parse_args()


def main(args=None):
    """
    Load the dataset(s) and reply it/them.
    """
    rclpy.init(args=args)

    args = parse_args()
    coloredlogs.install(level=args.log_level)
    log.setLevel(args.log_level)

    generic_publisher = GenericPublisher(
        args.paths,
        frequency=args.frequency,
        loop=args.loop,
        topic_filter=args.topic_filter,
    )
    rclpy.spin(generic_publisher)
    generic_publisher.destroy_node()
    rclpy.shutdown()


if __name__ == "__main__":
    main()
