# CPUs 2~5 (zero index)
export CPU_LIST_BIN=3C

# FLIR camera maker
export USB_ID="Point Grey Research, Inc."

sudo lsusb -v > /tmp/lsusb_verbose 2> /dev/null
sudo lspci -v > /tmp/lspci_verbose 2> /dev/null
cat /tmp/lsusb_verbose | grep "Bus .*$USB_ID" | awk -F' ' '{ print "Bus " $2 " Device 001"; }' > /tmp/lsusb_bus
cat /tmp/lsusb_bus | xargs -I {} sh -c "cat /tmp/lsusb_verbose | grep -A 20 '{}' | grep iSerial | awk -F' ' '{ print \$3; }' | awk -F':' '{ print \$2 \":\" \$3; }'" > /tmp/lsusb_pci
cat /tmp/lsusb_pci | xargs -I {} sh -c "cat /tmp/lspci_verbose | grep -A 5 {} | grep 'IRQ ' | awk -F'IRQ ' '{ print \$2; }' | awk -F',' '{ print \"irqbalance --banirq=\" \$1 \" && (echo $CPU_LIST_BIN | sudo tee /proc/irq/\" \$1 \"/smp_affinity)\"; }' " | sort | uniq | bash
