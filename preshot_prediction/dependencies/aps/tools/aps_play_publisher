# opencv
import cv2
import numpy as np

# ros
import rclpy
from nvjpeg import NvJpeg
from rclpy.node import Node

# camera
import ace_interfaces.msg


def parse_args():
    """
    Provide script-specific arguments.

    @return: Parsed argument object
    """

    parser = argparse.ArgumentParser(description="Player")
    parser.add_argument(
        "--path",
        type=str,
        required=True,
        default=None,
        help="Path to load images from",
    )
    parser.add_argument(
        "--use_racket",
        action="store_true",
        help="Use racket topic to generate images",
    )
    parser.add_argument(
        "--verbose",
        action="store_true",
        help="print verbose information (e.g. images not loaded)",
    )

    return parser.parse_args()


def list_files(path, extension):
    """TODO"""
    file_list = []
    for root, _, files in os.walk(path):
        for file in files:
            if file.lower().endswith(extension):
                file_list.append(os.path.join(root, file))

    return file_list


def rgb2bayer(bgr):
    """implementation for rgb2bayer
    # https://github.com/guochengqian/TENet/issues/5
    Converts from a RGB representation to Bayer8 representation
    """
    bayer = np.zeros((bgr.shape[0], bgr.shape[1]))
    bayer[0::2, 1::2] = bgr[0::2, 1::2, 1]
    bayer[0::2, 0::2] = bgr[0::2, 0::2, 2]
    bayer[1::2, 1::2] = bgr[1::2, 1::2, 0]
    bayer[1::2, 0::2] = bgr[1::2, 0::2, 1]
    return bayer.astype(np.uint8)


class Context:
    """
    This class manages the context of show camera utility tool, and manages the population of image topics
    """

    def __init__(self, path, use_racket, verbose):
        self.dummy_node = Node("play_images")
        self.topics = {}
        self.path = path
        self.use_racket = use_racket
        self.verbose = verbose
        time.sleep(1)  # Wait to populate topics
        # Set up subscriber.
        self.jpeg_encoder = NvJpeg()
        self.use_hardware_encoding = True

        self.images_paths = list_files(path, ".jpg")
        self.sequences = self._organize_by_seq_id(self.images_paths)
        self.sequences_keys = sorted(self.sequences.keys())
        self.image_map = {}
        self.camera_names = {}
        for image_path in self.images_paths:
            rel_path = "." + image_path[len(self.path) :]
            tmp_path = os.path.dirname(rel_path)
            if "image" in tmp_path:
                tmp_path = os.path.dirname(tmp_path)
            cam_name = os.path.basename(tmp_path)
            if cam_name not in self.camera_names:
                self.camera_names[cam_name] = os.path.dirname(rel_path)
            self.image_map[rel_path] = {
                "loaded": False,
                "sent": False,
                "image": None,
                "path": image_path,
            }

        print(self.camera_names)
        self.average_times = []

        if self.use_racket:
            # create publisher for all cameras
            topic_name = "/sensors/racket_0/racket_pose_estimation/pose"
            sub = self.dummy_node.create_subscription(
                ace_interfaces.msg.RacketPose,
                topic_name,
                self._racket_message_callback,
                1,
            )
            for cam, image_path in self.camera_names.items():
                published_topic_name = f"/sensors/{cam}/image"
                topic = self._add_publisher_internal(published_topic_name, sub)
                topic["camera"] = cam
                topic["img_rel_path"] = image_path

    def _organize_by_seq_id(self, files):
        groups = {}
        for file in files:
            candidates = re.findall(r"\d+", os.path.splitext(os.path.basename(file))[0])
            if len(candidates) == 0:
                continue
            seq_id = int(candidates[0])
            if seq_id not in groups:
                groups[seq_id] = []
            rel_path = "." + file[len(self.path) :]
            groups[seq_id].append([rel_path, file])
        return groups

    def destroy(self):
        """
        Destroy the object
        """
        self.dummy_node.destroy_node()

    def update(self):
        """
        Update is called when new topics were populated
        """

    def _add_publisher_internal(self, topic_name, subscriber):
        publisher = self.dummy_node.create_publisher(ace_interfaces.msg.ImageData, topic_name, 1)

        msg = ace_interfaces.msg.ImageData()
        msg.offset_x = 0
        msg.offset_y = 0
        msg.encoding = [0] * 20
        msg.encoding[: len("bayer_rggb8")] = [ord(c) for c in "bayer_rggb8"]

        self.topics[topic_name] = {
            "topic": topic_name,
            "publisher": publisher,
            "handle": subscriber,
            "message": msg,
        }
        return self.topics[topic_name]

    def _add_publisher(self, file_topic_name):
        sub = self.dummy_node.create_subscription(
            ace_interfaces.msg.FileImage,
            file_topic_name,
            functools.partial(self._file_message_callback, file_topic_name),
            1,
        )
        topic_name = "/".join(file_topic_name.split("/")[:-1])  # remove last part of the message, e.g. "/jpeg"
        self._add_publisher_internal(topic_name, sub)

    def _publish_image(self, path, topic, sequence_number):
        image_message = topic["message"]
        image_message.header.sequence_number = sequence_number

        if self.use_hardware_encoding:
            image_data = None
            try:
                with open(path, "rb") as file:
                    image_data = self.jpeg_encoder.decode(file.read())
            except Exception:  # pylint: disable=broad-except
                pass
        else:
            image_data = cv2.imread(path, cv2.IMREAD_COLOR)

        if image_data is None:
            if not self.use_racket:
                if self.verbose:
                    print("Image not loaded: ", path)
            return
        image_data = rgb2bayer(image_data)
        image_message.width = image_data.shape[1]
        image_message.height = image_data.shape[0]
        image_message.step = image_message.width
        size = image_message.step * image_message.height
        image_message.data[:size] = image_data.reshape(size)

        topic["publisher"].publish(image_message)

    def _file_message_callback(self, topic_name, msg):
        topic_name = "/".join(topic_name.split("/")[:-1])  # remove last part of the message, e.g. "/jpeg"
        topic = self.topics[topic_name]
        path = os.path.join(self.path, msg.path)

        self._publish_image(path, topic, msg.header.sequence_number)

    def _racket_message_callback(self, msg):
        for topic in self.topics.values():
            seq_id = str(msg.header.sequence_number)

            new_format = True
            if new_format:
                file_name = f"img{seq_id.zfill(8)}.jpg"
            else:
                file_name = f"{seq_id}.jpg"
            path = os.path.join(self.path, topic["img_rel_path"], file_name)

            self._publish_image(path, topic, msg.header.sequence_number)

    def refresh_topics(self):
        """
        check for any new image topics available, and update the context if necessary
        """
        rclpy.spin_once(self.dummy_node, timeout_sec=0.1)
        if self.use_racket:
            return
        # populate topics
        for topic_name, topic_types in self.dummy_node.get_topic_names_and_types():
            if "ace_interfaces/msg/FileImage" in topic_types:
                topic = "/".join(topic_name.split("/")[:-1])  # remove last part of the message, e.g. "/jpeg"
                if topic not in self.topics:
                    print("Topic discovered: " + topic_name)
                    self._add_publisher(topic_name)


if __name__ == "__main__":
    # Get all topics.
    rclpy.init()
    args = parse_args()
    _context = Context(args.path, args.use_racket, args.verbose)

    while rclpy.ok():
        _context.refresh_topics()
        _context.update()

    _context.destroy()
    cv2.destroyAllWindows()
