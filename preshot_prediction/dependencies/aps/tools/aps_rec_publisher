"""
Used to record raw images to jpeg files, and publish topics about the recorded file path
"""

import argparse
import subprocess


def parse_args():
    """
    Provide script-specific arguments.

    @return: Parsed argument object
    """

    parser = argparse.ArgumentParser(description="Recorder")
    parser.add_argument(
        "--path",
        type=str,
        required=True,
        default=None,
        help="Relative path to store images into",
    )
    parser.add_argument(
        "--quality",
        type=int,
        default=50,
        help="Quality of images [0-100]",
    )
    parser.add_argument(
        "--rate",
        type=int,
        default=50,
        help="Record max rate",
    )
    parser.add_argument(
        "--config",
        type=str,
        required=True,
        help="lab configuration name",
    )

    return parser.parse_args()


class Context:
    """
    This class manages the context of recorder utility tool
    """

    def __init__(self, path, quality, rate, config):
        self.path = path
        self.config = config
        self.quality = quality
        self.rate = rate
        self.timeout = max(1, int(200 / rate))  # assuming cameras are running at 200Hz
        cmd = (
            f"ros2 launch aps recorder.launch.py config:={config}"
            f" sampling:={self.timeout} quality:={quality} record_path:={path}"
            f" publish_events:=true"
        )

        self.process = subprocess.Popen(cmd.split(" "))  # pylint: disable=consider-using-with

    def destroy(self):
        """
        Destroy the object
        """
        self.process.terminate()

    def wait(self):
        """Wait until process is done"""
        self.process.wait()


if __name__ == "__main__":
    # Get all topics.
    args = parse_args()
    _context = Context(args.path, args.quality, args.rate, args.config)

    try:
        _context.wait()
    except Exception:  # pylint: disable=broad-except
        pass
    print("Closing recorder")
    _context.destroy()
