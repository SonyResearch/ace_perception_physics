def rgb2bayer(bgr):
    """implementation for rgb2bayer
    # https://github.com/guochengqian/TENet/issues/5
    Converts from a RGB representation to Bayer8 representation
    """
    bayer = np.zeros((bgr.shape[0], bgr.shape[1]))
    bayer[0::2, 1::2] = bgr[0::2, 1::2, 1]
    bayer[0::2, 0::2] = bgr[0::2, 0::2, 2]
    bayer[1::2, 1::2] = bgr[1::2, 1::2, 0]
    bayer[1::2, 0::2] = bgr[1::2, 0::2, 1]
    return bayer.astype(np.uint8)



class TopicData:
    def __init__(self) -> None:
        self.camera_name = ""
        self.video_reader: Optional[cv2.VideoCapture] = None
        self.curr_frame = 0
        self.frames = []
        self.publisher = None
        self.topic = ""
        self.message = None
        self.frame_cache = deque(maxlen=10)  # Cache for pre-loaded frames
        self.cache_lock = threading.Lock()
        self.reader_thread: Optional[threading.Thread] = None
        self.stop_reading = threading.Event()
        self.cache_ready = threading.Event()
        self.eof=False
class FrameReaderThread(threading.Thread):
    """Background thread to read frames from video and cache them."""
    
    def __init__(self, topic_data: TopicData, cache_size=10):
        super().__init__(daemon=True)
        self.topic_data = topic_data
        self.cache_size = cache_size
        
    def run(self):
        """Read frames in the background and cache them."""
        while not self.topic_data.stop_reading.is_set():
            with self.topic_data.cache_lock:
                # Only cache if we have space
                if len(self.topic_data.frame_cache) < self.cache_size:
                    ret, frame = self.topic_data.video_reader.read()
                    if ret:
                        image_data = rgb2bayer(frame)
                        self.topic_data.frame_cache.append(image_data)
                        self.topic_data.cache_ready.set()
                    else:
                        # End of video reached
                        break
                else:
                    # Cache is full, wait a bit
                    pass
            
            # Small sleep to prevent busy waiting
            time.sleep(0.005)

        self.topic_data.eof=True


class Context:
    """
    This class manages the context of show camera utility tool, and manages the population of image topics
    """

    def launch_process(self,cmd):
        try:
            pid = subprocess.Popen(
            cmd, shell=True
            )
        except Exception as e:
            self.dummy_node.get_logger().error(f"Failed to start player_pose process: {e}")
            pid = None
        return pid
    
    
    def control_logger(self, log_prefix):
        """Send a message to control the logger with a specified prefix"""
        loggercontrol_msg = ace_interfaces.msg.LoggerControl()
        loggercontrol_msg.log_prefix[: len(log_prefix)] = list(log_prefix.encode("utf-8"))
        self._loggercontrol_pub.publish(loggercontrol_msg)
        self.dummy_node.get_logger().info(f'Sent LoggerControl(log_prefix="{log_prefix}") message over ROS')

    def __init__(self, path):
        self.dummy_node = Node("play_videos")
        self.topics = {}
        self.path = path
        # Set up subscriber.
        self.player_pose_pid=None
        self.racket_pose_pid=None

        # config file name
        config_path=os.path.join(path,"tyo01.yaml")
        if not os.path.exists(config_path):
            raise FileNotFoundError(f"Config file not found: {config_path}")
        
        target_location=os.path.join(get_package_share_directory("calibration"), "parameters/camera_calibration","tyo01.yaml")
        shutil.copy(config_path, target_location)

        qos_persistent = rclpy.qos.QoSProfile(depth=1)
        qos_persistent.reliability = rclpy.qos.QoSReliabilityPolicy.RELIABLE
        qos_persistent.durability = rclpy.qos.QoSDurabilityPolicy.TRANSIENT_LOCAL
        self._loggercontrol_pub = self.dummy_node.create_publisher(
            ace_interfaces.msg.LoggerControl, "/logger/control", qos_persistent
        )
        self.clusters={}
        self.clusters["_a"]=["aps20501495","aps21107993","aps21115383","aps22071845","aps22240292"]
        self.clusters["_b"]=["aps20370530","aps21107992","aps22087079","aps22106662","aps22240282"]


    def close_processes(self):
        if self.player_pose_pid:
            self.player_pose_pid.terminate()
            self.player_pose_pid.wait()
        if self.racket_pose_pid:
            self.racket_pose_pid.terminate()

    def run_cluster(self, cluster_name):
        # Stop any existing reader threads
        for topic in self.topics.values():
            if topic.reader_thread and topic.reader_thread.is_alive():
                topic.stop_reading.set()
                topic.reader_thread.join(timeout=1.0)

        
        log_prefix=os.path.basename(self.path)
        log_dirname = os.environ.get("ACE_DATALOGGER_PATH", "./ace_logs")
        log_dirname=f"{log_dirname}OfflineProcessing/{log_prefix}"
        log_dirname = f"{log_dirname}/{log_prefix}{cluster_name}"

        if os.path.exists(log_dirname+"_player_pose.ace"):
            print("Recording exists, skipping")
            return False
        self.control_logger(log_dirname)
        
        cmd=f'ros2 launch player_pose player_pose_estimation.launch.py config:=tyo01 cluster:="{cluster_name}"'
        self.player_pose_pid=self.launch_process(cmd)
        cmd=f'ros2 launch racket_pose_estimation racket_pose_estimation.launch.py config:=tyo01 cluster:="{cluster_name}"'
        self.racket_pose_pid=self.launch_process(cmd)
        
        time.sleep(10)


        self.topics = {}
        self.synchronized_topics = {}
        self.all_frames = []
        self.current_frame = 0
        
        for camera_name in self.clusters[cluster_name]:
            video_path = os.path.join(self.path, f"{camera_name}.mp4")
            frames_path = os.path.join(self.path, f"{camera_name}_frames.txt")
            published_topic_name = f"/sensors/{camera_name}/image"
            if not os.path.exists(frames_path):
                continue
            topic: TopicData = self._add_publisher_internal(camera_name, published_topic_name)
            topic.camera_name = camera_name
            topic.video_reader = cv2.VideoCapture(video_path)

            with open(frames_path, "r") as f:
                topic.frames = [int(line.strip()) for line in f if line.strip()]

            topic.curr_frame = 0
            
            # Start background reader thread for this camera
            topic.reader_thread = FrameReaderThread(topic, cache_size=10)
            topic.reader_thread.start()

            for frame in topic.frames:
                self.synchronized_topics.setdefault(frame, []).append(camera_name)
        
        self.all_frames = sorted(self.synchronized_topics.keys())
        return True
    def destroy(self):
        """
        Destroy the object
        """
        # Stop all reader threads
        for topic in self.topics.values():
            if topic.reader_thread and topic.reader_thread.is_alive():
                topic.stop_reading.set()
                topic.reader_thread.join(timeout=1.0)
            if topic.video_reader:
                topic.video_reader.release()
        
        self.close_processes()
        self.dummy_node.destroy_node()

    def update(self):
        """
        Update is called when new topics were populated
        """
        if self.current_frame >= len(self.all_frames):
            return False
        
        frame = self.all_frames[self.current_frame]
        drop= len(self.synchronized_topics[frame])==1

        # print(f"{frame}: {self.synchronized_topics[frame]}")
        
        for camera in self.synchronized_topics[frame]:
            topic: TopicData = self.topics[camera]
            self._publish_image(topic, frame, drop)
        self.current_frame += 1

        # calculate update frame rate
        now = time.time()
        last = getattr(self, "_last_update_time", None)
        if last is not None:
            delta = now - last
            self._update_count+=1
            if delta > 1:
                self._update_fps = self._update_count / delta
                self._update_count=0
                # log the FPS
                self.dummy_node.get_logger().info(f"update_fps: {self._update_fps:.2f}")
                self._last_update_time = now
        else:
            self._update_fps = None
            self._update_count=1
            self._last_update_time = now

        return True
    def _add_publisher_internal(self, camera_name, topic_name):
        publisher = self.dummy_node.create_publisher(ace_interfaces.msg.ImageData, topic_name, 10)

        msg = ace_interfaces.msg.ImageData()
        msg.offset_x = 0
        msg.offset_y = 0
        msg.encoding = [0] * 20
        msg.encoding[: len("bayer_rggb8")] = [ord(c) for c in "bayer_rggb8"]

        self.topics[camera_name] = TopicData()
        self.topics[camera_name].topic = topic_name
        self.topics[camera_name].publisher = publisher
        self.topics[camera_name].message = msg
        return self.topics[camera_name]

    def _publish_image(self, topic: TopicData, sequence_number, drop):
        image_message = topic.message
        image_message.header.sequence_number = sequence_number

        # Try to get frame from cache first
        image_data = None
        while not topic.eof:
            with topic.cache_lock:
                if topic.frame_cache:
                    image_data = topic.frame_cache.popleft()
                    break
        
        # If cache is empty, read directly (fallback)
        if image_data is None:
            if topic.eof:
                print(f"EOF frame {sequence_number} for topic {topic.topic}")
                return
            raise RuntimeError("Frame cache is empty and direct read is not implemented")
        if drop:
            print(f"Dropping frame {sequence_number} for topic {topic.topic}")
            return
        image_message.width = image_data.shape[1]
        image_message.height = image_data.shape[0]
        image_message.step = image_message.width
        size = image_message.step * image_message.height
        image_message.data[:size] = image_data.reshape(size)

        topic.publisher.publish(image_message)


if __name__ == "__main__":
    # Get all topics.
    ProfileManager.get_instance().apply("perception_default_ros")
    rclpy.init()
    args = parse_args()
    _context = Context(args.path)

    try:
        if not _context.run_cluster(args.cluster):
            raise RuntimeError("Failed to run cluster")
        while rclpy.ok():
            if not _context.update():
                break
            time.sleep(0.02)
    except KeyboardInterrupt:
        pass
    except RuntimeError as e:
        print(f"Runtime error: {e}")
    finally:
        _context.destroy()
        cv2.destroyAllWindows()
