class RobotTask:
    """Class to run predefined robot tasks."""

    TASKS = {
        "left_corner": ["xy_musashi_zero", "task_table_left_corner"],
        "right_corner": ["xy_musashi_zero", "task_table_right_corner"],
        "reset": ["xy_musashi_zero"],
        "center_near": ["xy_musashi_zero", "task_table_center_near"],
        "center_mid": ["xy_musashi_zero", "task_table_center_mid"],
        "center_far": ["xy_musashi_zero", "task_table_center_far"],
    }
    RobotStates = {
        "task_table_left_corner": np.concatenate(
            (
                np.array([-0.5 * TableDimensions.length, -0.5 * TableDimensions.width, 0.2]),
                (
                    Rotation.from_rotvec(0.5 * np.pi * np.array([1, 0, 0]))
                    * Rotation.from_rotvec(np.pi * np.array([0, 0, 1]))
                    * Rotation.from_rotvec(-0.3 * np.pi * np.array([0, 1, 0]))
                ).as_quat(),
            )
        ),
        "task_table_right_corner": np.concatenate(
            (
                np.array([-0.5 * TableDimensions.length, 0.5 * TableDimensions.width, 0.2]),
                (
                    Rotation.from_rotvec(-0.5 * np.pi * np.array([1, 0, 0]))
                    * Rotation.from_rotvec(np.pi * np.array([0, 0, 1]))
                    * Rotation.from_rotvec(-0.3 * np.pi * np.array([0, 1, 0]))
                ).as_quat(),
            )
        ),
        "task_table_center_near": np.concatenate(
            (
                np.array([-0.5 * TableDimensions.length, 0, 0.2]),
                (
                    Rotation.from_rotvec(-0.5 * np.pi * np.array([1, 0, 0]))
                    * Rotation.from_rotvec(np.pi * np.array([0, 0, 1]))
                    * Rotation.from_rotvec(-0.5 * np.pi * np.array([0, 1, 0]))
                ).as_quat(),
            )
        ),
        "task_table_center_mid": np.concatenate(
            (
                np.array([-0.3 * TableDimensions.length, 0, 0.2]),
                (
                    Rotation.from_rotvec(-0.5 * np.pi * np.array([1, 0, 0]))
                    * Rotation.from_rotvec(np.pi * np.array([0, 0, 1]))
                ).as_quat(),
            )
        ),
        "task_table_center_far": np.concatenate(
            (
                np.array([-0.1 * TableDimensions.length, 0, 0.2]),
                (
                    Rotation.from_rotvec(-0.5 * np.pi * np.array([1, 0, 0]))
                    * Rotation.from_rotvec(np.pi * np.array([0, 0, 1]))
                ).as_quat(),
            )
        ),
    }

    def __init__(self) -> None:
        self.last_task = ""

    def run_single_task(self, task_name: str):
        """Run a single task"""
        err = None
        if task_name == self.last_task:
            return err
        if task_name not in RobotTask.RobotStates and task_name not in PREDEFINED_STATES:
            glog.error(f"Unknown task name: {task_name}")
            return err
        self.last_task = task_name
        glog.info(f" --> Running task: {task_name}")

        general_params = GeneralParameters(game_mode=False, simulation=False, log_level="warn", plot=False)
        robot_params = RobotParameters(
            robot_name="xy_musashi_markII_with_calibration_tool",
            control_freq=1000,
            rt_profile="open_loop_pybind_interface",
        )
        collision_params = CollisionDetectorParameters(
            step_size=1, safety_distance=0.02, rt_profile="collision_detection_open_loop"
        )
        state_name = task_name if task_name in PREDEFINED_STATES else ""
        pose = RobotTask.RobotStates[task_name] if task_name in RobotTask.RobotStates else None
        controller = TrajectoryReplayNode(
            general_config=general_params,
            collision_config=collision_params,
            robot_config=robot_params,
            target_state_name=state_name,
            target_task_pos=pose,
        )
        controller.set_ruckig_aggressiveness(0.1, 0.1, 0.1)
        if controller.using_pybind_interface():
            controller.start_pybind_interface()
            controller.join_pybind_interface_process()
        else:
            try:
                rclpy.spin(controller)
            except EndOfProgramException:
                glog.info(f"Final joint pos: {controller.executed_trajectory[1][-1][0]}")
                glog.info("Task completed successfully.")
            except Exception:  # pylint: disable=broad-except
                glog.error(f"{traceback.format_exc()}")
                controller.stop_robot_interface()
            controller.destroy_node()

        if pose is not None:
            # Compute IK error
            intended_position = pose[:3]
            actual_position = controller.kinematics.convert_to_end_effector_trajectory(
                controller.executed_trajectory[1][-1][0], table_frame=True
            )[0][:3]
            err = intended_position - actual_position
            glog.info(f"IK Error: [{err[0]:.4f}, {err[1]:.4f}, {err[2]:.4f}] m")
            # also adjust for tool height if available
            err[2] -= pose[2]

        return err

    def run_task(self, task_name: str):
        """Run task sequence"""
        glog.info(f"Running task sequence: {task_name}")
        for single_task in RobotTask.TASKS[task_name]:
            err = self.run_single_task(single_task)
        return err

        # query EF position error

    def run_center_scan(self):
        """Move the robot across the center line of the table."""
        self.run_task("reset")
        self.run_task("center_scan")

    def reset(self):
        """Reset robot position"""
        self.run_task("reset")


class TablePositionAssistant(Node):
    """Node to measure table flatness using wand calibration data."""

    SAMPLES_COUNT = 100
    MEASURING_BALL_HEIGHT = 0.02432  # height of the ball on the measuring tool

    class TaskState:
        """Class to store task state information."""

        def __init__(self, task_name, ball_position) -> None:
            self.task_name = task_name
            self.ball_position = np.array(ball_position)

    def __init__(self):
        super().__init__("table_position_assistant_node")

        self.is_done = False

        self.robot_task = RobotTask()

        self.points_to_test: List[TablePositionAssistant.TaskState] = []
        self.points_to_test.append(
            TablePositionAssistant.TaskState(
                "left_corner",
                [-TableDimensions.length / 2, TableDimensions.width / 2, 0],
            )
        )
        self.points_to_test.append(
            TablePositionAssistant.TaskState(
                "right_corner",
                [-TableDimensions.length / 2, -TableDimensions.width / 2, 0],
            )
        )
        self.points_to_test.append(
            TablePositionAssistant.TaskState(
                "center_near",
                [-0.5 * TableDimensions.length, 0, 0],
            )
        )
        self.points_to_test.append(
            TablePositionAssistant.TaskState(
                "center_mid",
                [-0.3 * TableDimensions.length, 0, 0],
            )
        )
        self.points_to_test.append(
            TablePositionAssistant.TaskState(
                "center_far",
                [-0.1 * TableDimensions.length, 0, 0],
            )
        )

        self.current_point_idx = 0
        self.current_point = None
        self.ready_to_test = False
        self.end_effector_err = None

        qos_profile = rclpy.qos.QoSProfile(depth=1)
        self.ball_subscriber = self.create_subscription(
            ace_interfaces.msg.PointsWithCovariance,
            "/sensors/ball_triangulation/points",
            self.on_ball_pose_callback,
            qos_profile=qos_profile,
        )

        # self.keyboard_listener = Listener(on_press=lambda key: self.on_press(key))
        # self.keyboard_listener.start()

        self.keyboard = KBHit()
        self.samples = deque(maxlen=TablePositionAssistant.SAMPLES_COUNT)
        self.reset(force=True)
        self.next()

    def prompt_user_confirmation(self, task_name: str):
        """prompt_user_confirmation"""
        result = False
        self.keyboard.set_normal_term()
        while True:
            print(f"\n{Fore.GREEN} ---------- MAKE SURE BUTTON IS PRESSED ---------- {Style.RESET_ALL}")
            user_input = input(f"Robot will perform '{task_name}' to move to the next point? press [Y] when ready: ")
            match user_input.lower():
                case "y":
                    result = True
                    break
                case "n":
                    print("Aborting.")
                    result = False
                    break
                case _:
                    print("Invalid input. Please enter 'y' or 'n'.")
        self.keyboard.set_new_term()
        return result

    def run_robot_task(self, task_name: str, test_mode: bool, force: bool = False):
        """run_robot_task"""
        self.ready_to_test = False
        if force or self.prompt_user_confirmation(task_name):
            self.end_effector_err = self.robot_task.run_task(task_name)
            if self.end_effector_err is not None:
                err = self.end_effector_err
                glog.info(f"End effector Offset: [{err[0]:.4f}, {err[1]:.4f}, {err[2]:.4f}] m")
            self.ready_to_test = test_mode
        else:
            self.is_done = True
        return not self.is_done

    def reset(self, force=False):
        """reset position. If force is true, no user confirmation is required."""

        self.samples.clear()
        self.current_point_idx = -1
        self.current_point = None
        if not self.run_robot_task("reset", False, force=force):
            return

    def done(self):
        """Check if done"""
        return self.is_done

    def destroy_node(self):
        """destroy"""
        self.keyboard.set_normal_term()
        self.ball_subscriber = None
        super().destroy_node()

    def on_ball_pose_callback(self, msg):
        """ROS callback for ball pose"""
        try:
            if self.current_point is None or not self.ready_to_test:
                return
            if len(msg.points) != 2:
                return

            ball_pos = np.array([msg.points[0].position.x, msg.points[0].position.y, msg.points[0].position.z])
            robot_pos = np.array([msg.points[1].position.x, msg.points[1].position.y, msg.points[1].position.z])
            if ball_pos[2] > robot_pos[2]:  # Robot ball should be always higher
                ball_pos, robot_pos = robot_pos, ball_pos

            if self.end_effector_err is not None:
                robot_pos += self.end_effector_err  # Adjust for EF position error

            ball_pos[2] -= TablePositionAssistant.MEASURING_BALL_HEIGHT  # adjust for ball height

            diff = robot_pos - ball_pos
            self.samples.append(diff)
        except Exception as err:  # pylint: disable=broad-except
            print(err)

    def report_differences(self):
        """report_height_differences"""
        if len(self.samples) == 0:
            return

        print("\r", end="")
        print(" " * 50, end="")

        text = "\r"
        for i in range(3):
            median_position = np.median([s[i] for s in list(self.samples)])
            color = Fore.GREEN if math.isclose(median_position, 0, abs_tol=0.002) else Fore.RED
            text += f"{color}{median_position*1e3:.1f} mm\t"

        text += " " + Style.RESET_ALL
        print(text, end="")

    def update(self):
        """update"""
        self.report_differences()
        if self.keyboard.kbhit():
            key = self.keyboard.getch()
            try:
                self.process_key(key)
            except Exception as err:  # pylint: disable = broad-except
                print(err)

    def next(self):
        """next"""
        if self.current_point_idx == len(self.points_to_test) - 1:
            print("Done, backing to first point.")
            self.reset()
            self.next()
            return
        self.current_point_idx += 1
        self.current_point = self.points_to_test[self.current_point_idx]
        self.run_robot_task(self.current_point.task_name, True)
        print(
            f"Please move the ball to point X:{self.current_point.ball_position[0]:.3f} m, "
            f"Y:{self.current_point.ball_position[1]:.3f} m and Z:{self.current_point.ball_position[2]:.3f} m"
        )
        print("Collecting samples... Press 'x' to go to the next point, 'r' to reset, 'q' to quit.")

    def check_center_scan(self):
        """check_center_scan"""
        if not self.run_robot_task("reset", False):
            return
        self.run_robot_task("center_scan", True)

    def process_key(self, key):
        """Process keyboard keys"""
        match key:
            case "q":
                self.is_done = True
            case "r":
                self.reset()
            case "x":
                self.next()


def main():
    """main function"""
    np.set_printoptions(suppress=True, precision=3)

    rclpy.init()
    node = TablePositionAssistant()
    try:
        while rclpy.ok() and not node.done():
            rclpy.spin_once(node, timeout_sec=0.1)
            node.update()
    except KeyboardInterrupt:
        pass
    finally:
        node.reset(force=True)
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main()
