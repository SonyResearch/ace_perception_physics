<?xml version="1.0" ?>
<robot name="ball">
  <link name="baseLink">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.0027"/>
      <inertia ixx="7.2e-7" ixy="0" ixz="0" iyy="7.2e-7" iyz="0" izz="7.2e-7"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="textured_sphere.obj" scale="0.02 0.02 0.02"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
