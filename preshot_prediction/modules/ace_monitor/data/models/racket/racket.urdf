<?xml version="1.0" ?>
<robot name="racket">
  <link name="baseLink">
    <visual>
      <origin rpy="0 0 0" xyz="0.15 0 0"/>
      <geometry>
        <mesh filename="model.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.15 0 0"/>
      <geometry>
        <mesh filename="model.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.20"/>
      <inertia ixx="0.00144666666667" ixy="0" ixz="0" iyy="0.00144666666667" iyz="0" izz="0.00289"/>
    </inertial>
  </link>
</robot>
