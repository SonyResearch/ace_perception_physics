<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>multi_ball_triangulation</name>
  <version>1.0.74</version>
  <description>Package to triangulate the ball position from ball detections of multiple APS/EVS cameras.</description>
  <maintainer email="dario.brescianini@sony.com">SonyAI-Zurich</maintainer>
  <license>Confidential, Copyright 2025, Sony AI, All rights reserved.</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend >ace_setuptools</depend>
  <depend >vision_common</depend>
  <depend >ace_loggers</depend>
  <depend >ace_yaml</depend>
  <depend >ace_interfaces</depend>
  <depend >base_parameters</depend>
  <depend >calibration</depend>
  <depend >dot_projector</depend>
  <depend>pybind11_vendor</depend>
  <depend>rclcpp</depend>
  <depend >triangulation</depend>
  <depend>ace_rt_profiles</depend>
  <depend>ball_detection_aps</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
