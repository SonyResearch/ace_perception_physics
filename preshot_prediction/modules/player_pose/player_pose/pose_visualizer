import numpy as np

import cv2
import colored_glog as glog
from ace_loggers import logger_pybind as logger

# ros
import rclpy
from rclpy.node import Node
from aps import python_module as aps
import ace_interfaces.msg


def set_level(log_level: int = 0) -> None:
    """Parse C++ glog level to PyPI glog"""
    logger.initialize()
    logger.set_level(str(log_level))
    if log_level == 0:
        glog.setLevel("INFO")
    elif log_level == 1:
        glog.setLevel("WARNING")
    elif log_level == 2:
        glog.setLevel("ERROR")
    elif log_level == 3:
        glog.setLevel("FATAL")


set_level(0)


class PlayerPose2DVisualizer:
    """Visualizes 2D player pose and hand detection on APS images."""

    def __init__(self):
        self.pose_2d = None
        self.detection = None
        self.detection_visibility = 0
        self.last_image = None

    def render_image(self, image_raw):
        """Render the image with overlays."""
        image = cv2.cvtColor(image_raw, cv2.COLOR_BayerBG2BGR)

        # COCO17 keypoint skeleton and colors
        COCO17_SKELETON = [  # pylint: disable=invalid-name
            (0, 1),
            (0, 2),
            (1, 3),
            (2, 4),
            (5, 7),
            (7, 9),
            (6, 8),
            (8, 10),
            (5, 6),
            (5, 11),
            (6, 12),
            (11, 12),
            (11, 13),
            (13, 15),
            (12, 14),
            (14, 16),
        ]
        COCO17_COLORS = [  # pylint: disable=invalid-name
            (255, 0, 0),  # Nose to left eye
            (0, 255, 0),  # Nose to right eye
            (255, 0, 255),  # left eye to left ear
            (0, 255, 255),  # right eye to right ear
            (255, 128, 0),  # left shoulder to left elbow
            (255, 255, 0),  # left elbow to left wrist
            (128, 0, 255),  # right shoulder to right elbow
            (0, 128, 255),  # right elbow to right wrist
            (0, 0, 255),  # left shoulder to right shoulder
            (128, 255, 0),  # left shoulder to left hip
            (0, 255, 128),  # right shoulder to right hip
            (128, 128, 128),  # left hip to right hip
            (255, 0, 128),  # left hip to left knee
            (128, 0, 0),  # left knee to left ankle
            (0, 128, 0),  # right hip to right knee
            (0, 0, 128),  # right knee to right ankle
        ]
        if self.pose_2d is not None and len(self.pose_2d.keypoints) != 0:
            visibility_threshold = 0.1
            for i, kp in enumerate(self.pose_2d.keypoints):  # pylint: disable=invalid-name
                x, y = int(kp[0]), int(kp[1])  # pylint: disable=invalid-name
                v = kp[2] if len(kp) > 2 else 1.0  # pylint: disable=invalid-name
                if v > visibility_threshold:
                    cv2.circle(image, (x, y), radius=3, color=(0, 0, 255), thickness=-1)
            # Draw skeleton links
            for idx, (i, j) in enumerate(COCO17_SKELETON):  # pylint: disable=invalid-name
                if i < len(self.pose_2d.keypoints) and j < len(self.pose_2d.keypoints):
                    xi, yi, vi = self.pose_2d.keypoints[i][:3]  # pylint: disable=invalid-name
                    xj, yj, vj = self.pose_2d.keypoints[j][:3]  # pylint: disable=invalid-name
                    if vi > visibility_threshold and vj > visibility_threshold:
                        color = COCO17_COLORS[idx % len(COCO17_COLORS)]
                        cv2.line(image, (int(xi), int(yi)), (int(xj), int(yj)), color, thickness=2)

        if self.detection is not None and self.detection_visibility > 0.1:
            cv2.circle(
                image,
                (int(self.detection[0]), int(self.detection[1])),
                radius=int(10 / self.detection_visibility),
                color=(0, 0, 255),
                thickness=-1,
            )

        cv2.imshow("result", image)
        cv2.waitKey(1)

    def on_hand_callback(self, msg: ace_interfaces.msg.BallsWithAttributes):
        """Callback for hand detection messages."""
        if len(msg.balls) == 0:
            self.detection = None
            self.detection_visibility = 0
        else:
            self.detection = [msg.balls[0].ball.center.x, msg.balls[0].ball.center.y]
            self.detection_visibility = msg.balls[0].ball.radius
        if self.last_image is not None:
            self.render_image(self.last_image)
            self.last_image = None

    def run_visualizer(self, camera_name):
        """Run the 2D player pose visualizer node."""
        rclpy.init()
        rclpy_node = Node("player_visualizer")
        image_sub = aps.ZeroCopySubscriber()

        hand_subscriber = rclpy_node.create_subscription(  # pylint: disable=unused-variable
            ace_interfaces.msg.BallsWithAttributes, "/sensors/player_pose/hand", self.on_hand_callback, 1
        )

        image_handler = image_sub.add_subscription(f"/sensors/aps{camera_name}/image")
        last_frame = -1
        while rclpy.ok():
            rclpy.spin_once(rclpy_node, timeout_sec=0)
            (
                ret,
                frame_id,
                _,
                imgs_raw,
            ) = image_sub.get_latest_message(image_handler)
            if ret and frame_id != last_frame:
                last_frame = frame_id
                self.last_image = np.array(imgs_raw)
            image_sub.release_latest_message(image_handler)


if __name__ == "__main__":
    detector = PlayerPose2DVisualizer()
    detector.run_visualizer("23175981")
