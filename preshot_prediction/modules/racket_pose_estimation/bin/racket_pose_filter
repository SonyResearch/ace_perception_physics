#!/usr/bin/env python3
# Confidential, Copyright 2026, Sony AI, All rights reserved.
"""Online filtering for racket pose estimations.
It will automatically popuate the existing ros2 topics for racket pose,
creates a corrector and publisher for each topic"""

import functools
import logging
import os
import numpy as np
import ace_yaml as yaml
from ament_index_python import get_package_share_directory
import rclpy
import rclpy.node
from racket_pose_estimation.pose_correction.racket_pose_corrector import RacketPoseCorrector, CorrectorConfig
import ace_interfaces.msg


log = logging.getLogger(__name__)


class OnlineFilterNode(rclpy.node.Node):
    """Online filtering ros node"""

    def __init__(self):
        """Initialize the online filter node."""
        super().__init__("racket_pose_filter_node")
        self.declare_parameter("config", "config_mekf")

        config = self.get_parameter("config").get_parameter_value().string_value

        config_path = os.path.join(
            get_package_share_directory("racket_pose_estimation"), "parameters", "corrector", config + ".yaml"
        )

        with open(config_path, "r", encoding="utf8") as file_handler:
            config_data = yaml.safe_load(file_handler)

        self.config = CorrectorConfig.from_dict(config_data)
        self.topics = {}
        self.timer = self.create_timer(0.1, self._timer_callback)

    def refresh_topics(self):
        """Refresh the topics to ensure we have the latest racket pose topics."""
        for (
            topic_name,
            topic_types,
        ) in self.get_topic_names_and_types():
            if "ace_interfaces/msg/RacketPoseEstimate" in topic_types:
                if topic_name not in self.topics and not topic_name.endswith("_filtered"):
                    print("Adding: ", topic_name)
                    self.topics[topic_name] = {}
                    self.topics[topic_name]["last_sequence_number"] = -1
                    self.topics[topic_name]["publisher"] = self.create_publisher(
                        ace_interfaces.msg.RacketPoseEstimate, f"{topic_name}_filtered", 1
                    )
                    self.topics[topic_name]["corrector"] = RacketPoseCorrector(self.config)
                    self.topics[topic_name]["message"] = ace_interfaces.msg.RacketPoseEstimate()

                    self.topics[topic_name]["subscriber"] = self.create_subscription(
                        ace_interfaces.msg.RacketPoseEstimate,
                        f"{topic_name}",
                        functools.partial(self.on_racket_pose, topic_name),
                        1,
                    )

    def on_racket_pose(self, topic_name, message: ace_interfaces.msg.RacketPoseEstimate):
        """Callback for racket pose messages."""
        topic = self.topics[topic_name]

        quat_confidence = 1 - min(1, message.orientation_error / 10)  # Orientation confidence: 1 - orientation_error
        overall_confidence = (
            message.confidence
        )  # Overall confidence, reflects the number of cameras observing the racket
        pos_confidence = 1 - min(
            1, message.projection_error / 10
        )  # Position confidence: 1 - reprojection error normalized to 10px

        delta_seq = message.pose.header.sequence_number - topic["last_sequence_number"]
        if topic["last_sequence_number"] < 0:
            delta_seq = 0
        topic["last_sequence_number"] = message.pose.header.sequence_number

        delta_time = delta_seq * 1e-3

        pose = {
            "delta_time": delta_time,
            "position": [message.pose.position.x, message.pose.position.y, message.pose.position.z],
            "orientation": [
                message.pose.orientation.x,
                message.pose.orientation.y,
                message.pose.orientation.z,
                message.pose.orientation.w,
            ],
            "pos_confidence": pos_confidence * overall_confidence,
            "quat_confidence": quat_confidence * overall_confidence,
        }
        if not message.pose.tracked:
            corrected_pose = topic["corrector"].predict(delta_time)
        else:
            corrected_pose = topic["corrector"].correct_pose(pose)
        topic["message"].pose.header = message.pose.header

        topic["message"].pose.tracked = corrected_pose is not None

        if corrected_pose:
            topic["message"].pose.position.x = float(corrected_pose["position"][0])
            topic["message"].pose.position.y = float(corrected_pose["position"][1])
            topic["message"].pose.position.z = float(corrected_pose["position"][2])

            topic["message"].pose.orientation.x = float(corrected_pose["orientation"][0])
            topic["message"].pose.orientation.y = float(corrected_pose["orientation"][1])
            topic["message"].pose.orientation.z = float(corrected_pose["orientation"][2])
            topic["message"].pose.orientation.w = float(corrected_pose["orientation"][3])
            topic["message"].orientation_error = message.orientation_error
            topic["message"].confidence = message.confidence
            topic["message"].projection_error = message.projection_error
        else:
            topic["message"].pose.position.x = float(np.nan)
            topic["message"].pose.position.y = float(np.nan)
            topic["message"].pose.position.z = float(np.nan)

            topic["message"].pose.orientation.x = float(0)
            topic["message"].pose.orientation.y = float(0)
            topic["message"].pose.orientation.z = float(0)
            topic["message"].pose.orientation.w = float(1)

            topic["message"].orientation_error = float(1)
            topic["message"].confidence = float(0)
            topic["message"].projection_error = float(100)
        topic["publisher"].publish(topic["message"])

    def _timer_callback(self):
        """Timer callback to refresh topics and update correctors."""
        self.refresh_topics()


def main(args=None):
    """run as standalone node"""
    rclpy.init(args=args)
    node = OnlineFilterNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    except SystemExit:
        pass
    finally:
        log.info("Done")
    node.destroy_node()


if __name__ == "__main__":
    main()
